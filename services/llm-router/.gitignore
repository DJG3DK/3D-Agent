# ── Secrets ──────────────────────────────────────────────────────────────────
# config.yaml references keys as os.environ/… and is safe to publish; the values
# live here and never leave the box.
.env
.env.*
!.env.example

# ── Python env ───────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc

# ── Runtime ──────────────────────────────────────────────────────────────────
# routing.jsonl is every routed request (model, tier, cost) — deployment data,
# and it grows without bound.
logs/
*.log
*.bak
*.bak-*
