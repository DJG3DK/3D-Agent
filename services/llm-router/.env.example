# The one upstream key: every model call this router makes is billed here.
OPENROUTER_API_KEY=

# The router's own auth. Every service that calls the router presents this —
# it must match LITELLM_API_KEY in the agent's .env. Generate something long:
#   openssl rand -hex 32
LITELLM_MASTER_KEY=

# Read by services/agent-review/server.js to authorise merge/deploy. Must equal
# REVIEW_CONTROL_SECRET in the agent's own .env.
REVIEW_CONTROL_SECRET=

# WebAuthn gate for the public admin panel (auth-gate/server.mjs, started by
# ecosystem.config.js as llm-auth-gate). Passkeys are bound to this hostname,
# so both must match the vhost nginx serves the panel on. Only set these if
# you expose /ui publicly; a private-only deployment does not run the gate.
GATE_RP_ID=
GATE_ORIGIN=
# GATE_PORT=4010
